<templates>
  <t t-name="o-spreadsheet-SpeechBubble">
    <Portal target="'.o-spreadsheet'">
      <div class="o-speech-bubble position-absolute px-3 border" t-ref="this.bubbleRef">
        <div class="o-speech-content text-truncate pb-1" t-out="this.props.content"/>
      </div>
    </Portal>
  </t>
</templates>
