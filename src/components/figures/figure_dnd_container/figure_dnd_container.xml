<templates>
  <t t-name="o-spreadsheet-FiguresDragAndDropContainer">
    <div class="position-absolute">
      <div
        class="o-figure-container o-figure-drag-container position-absolute pe-none overflow-hidden"
        t-if="this.container"
        t-att-style="this.container.style"
        t-att-data-id="'dndContainer'">
        <div
          class="o-figure-viewport-inverse w-0 h-0 overflow-visible position-absolute"
          t-att-style="this.container.inverseViewportStyle">
          <t t-if="this.container.type == 'dnd' and this.figureDndPlugin.dnd.selectedRect">
            <div t-att-style="this.selectedRectStyle" class="position-absolute o-selected-border"/>
          </t>
          <t t-foreach="this.container.figures" t-as="figureUI" t-key="figureUI.id">
            <FigureComponent
              figureUI="figureUI"
              style="this.getFigureStyle(figureUI)"
              class="this.getFigureClass(figureUI)"
            />
          </t>
        </div>
      </div>
    </div>
    <div
      class="o-figure-container position-absolute pe-none overflow-hidden"
      t-if="this.figureDndPlugin.dnd.horizontalSnap"
      t-att-style="this.figureDndPlugin.dnd.horizontalSnap.containerStyle"
      t-att-data-id="'HorizontalSnapContainer'">
      <div
        class="o-figure-snap-line horizontal"
        t-att-style="this.figureDndPlugin.dnd.horizontalSnap.lineStyle"
      />
    </div>
    <div
      class="o-figure-container position-absolute pe-none overflow-hidden"
      t-if="this.figureDndPlugin.dnd.verticalSnap"
      t-att-style="this.figureDndPlugin.dnd.verticalSnap.containerStyle"
      t-att-data-id="'VerticalSnapContainer'">
      <div
        class="o-figure-snap-line vertical"
        t-att-style="this.figureDndPlugin.dnd.verticalSnap.lineStyle"
      />
    </div>
  </t>
</templates>
