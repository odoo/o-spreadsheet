<templates>
  <t t-name="o-spreadsheet-ChartMergeGroups">
    <Section t-if="this.hasMultipleLabelRanges" class="'pt-0'" title.translate="Categories">
      <Checkbox
        name="'mergeGroups'"
        label.translate="Merge identical categories"
        value="this.props.definition.mergeGroups"
        onChange="(mergeGroups) => this.props.updateChart(this.props.chartId, { mergeGroups })"
        className="'mb-2'"
      />
    </Section>
  </t>
</templates>
