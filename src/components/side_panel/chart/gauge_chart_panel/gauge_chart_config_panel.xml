<templates>
  <t t-name="o-spreadsheet-GaugeChartConfigPanel">
    <div>
      <Section class="'o-data-series'">
        <t t-set-slot="title">
          <div class="d-flex flex-row justify-content-between">Data range</div>
        </t>
        <StandaloneComposer
          placeholder.translate="Formula"
          title.translate=""
          composerContent="this.ranges.toString()"
          defaultRangeSheetId="this.env.model.getters.getActiveSheetId()"
          onConfirm.bind="this.updateMetric"
        />
      </Section>

      <ChartErrorSection
        t-if="this.configurationErrorMessages.length"
        messages="this.configurationErrorMessages"
      />
    </div>
  </t>
</templates>
