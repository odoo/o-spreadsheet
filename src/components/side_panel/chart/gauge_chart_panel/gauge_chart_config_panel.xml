<templates>
  <t t-name="o-spreadsheet-GaugeChartConfigPanel">
    <div>
      <Section class="'o-data-series'" title.translate="Data range">
        <StandaloneComposer
          placeholder.translate="Formula"
          title.translate=""
          composerContent="this.getMetric()"
          defaultRangeSheetId="this.env.model.getters.getActiveSheetId()"
          onConfirm.bind="this.onConfirmMetric"
        />
      </Section>

      <ChartErrorSection
        t-if="this.configurationErrorMessages.length"
        messages="this.configurationErrorMessages"
      />
    </div>
  </t>
</templates>
