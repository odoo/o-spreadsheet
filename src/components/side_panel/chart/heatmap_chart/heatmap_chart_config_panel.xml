<templates>
  <t t-name="o-spreadsheet-HeatmapChartConfigPanel">
    <div>
      <ChartLabelRange
        title.translate="Horizontal axis values"
        range="this.getRange('xRange')"
        isInvalid="this.isRangeInvalid('xRange')"
        onSelectionChanged="(ranges) => this.onRangeChanged('xRange', ranges)"
        onSelectionConfirmed="() => this.onRangeConfirmed('xRange')"
      />
      <ChartLabelRange
        title.translate="Vertical axis values"
        range="this.getRange('yRange')"
        isInvalid="this.isRangeInvalid('yRange')"
        onSelectionChanged="(ranges) => this.onRangeChanged('yRange', ranges)"
        onSelectionConfirmed="() => this.onRangeConfirmed('yRange')"
        class="'pt-0'"
      />
      <ChartLabelRange
        title.translate="Values"
        range="this.getRange('sizeRange')"
        isInvalid="this.isRangeInvalid('sizeRange')"
        onSelectionChanged="(ranges) => this.onRangeChanged('sizeRange', ranges)"
        onSelectionConfirmed="() => this.onRangeConfirmed('sizeRange')"
        class="'pt-0'"
        options="this.getSizeRangeOptions()"
      />

      <ChartErrorSection t-if="this.errorMessages.length" messages="this.errorMessages"/>
    </div>
  </t>
</templates>
