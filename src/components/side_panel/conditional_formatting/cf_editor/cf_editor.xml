<templates>
  <t t-name="o-spreadsheet-ConditionalFormattingEditor">
    <div class="o-cf-editor">
      <Section class="'o-cf-range pb-0'" title.translate="Apply to range">
        <div class="o-selection-cf">
          <SelectionInput
            ranges="this.cfEditorPlugin.state.ranges"
            class="'o-range'"
            isInvalid="this.cfEditorPlugin.isRangeValid"
            onSelectionChanged="(ranges) => this.cfEditorPlugin.onRangeUpdate(ranges)"
            onSelectionConfirmed="() => this.cfEditorPlugin.onRangeConfirmed()"
            required="true"
          />
        </div>
      </Section>
      <Section class="'pb-0'" title.translate="Format rules">
        <div class="o-cf-type-selector">
          <BadgeSelection
            choices="this.cfTypesValues"
            onChange="(ruleType) => this.cfEditorPlugin.changeRuleType(ruleType)"
            selectedValue="this.cfEditorPlugin.state.currentCFType"
          />
        </div>
      </Section>
      <Section>
        <CellIsRuleEditor t-if="this.cfEditorPlugin.state.currentCFType === 'CellIsRule'"/>
        <ColorScaleRuleEditor t-if="this.cfEditorPlugin.state.currentCFType === 'ColorScaleRule'"/>
        <IconSetRuleEditor t-if="this.cfEditorPlugin.state.currentCFType === 'IconSetRule'"/>
        <DataBarRuleEditor t-if="this.cfEditorPlugin.state.currentCFType === 'DataBarRule'"/>
      </Section>
      <Section class="'pt-1'">
        <div class="o-sidePanelButtons">
          <button t-on-click="this.onCancel" class="o-button o-cf-cancel">Discard</button>
          <button
            t-on-click="this.onSave"
            class="o-button primary o-cf-save"
            t-att-disabled="this.cfEditorPlugin.state.errors.length !== 0">
            Save
          </button>
        </div>
      </Section>
      <Section>
        <ValidationMessages messages="this.cfEditorPlugin.errorMessages" msgType="'error'"/>
      </Section>
    </div>
  </t>
</templates>
