<templates>
  <div t-name="o-spreadsheet-DataAnalysisPanel" class="o-data-analysis-panel p-2">
    <div t-if="this.store.hasData">
      <SidePanelCollapsible title.translate="Suggested charts" isInitiallyCollapsed="false">
        <t t-set-slot="content">
          <div t-if="this.store.chartSuggestions.length" class="o-chart-suggestions-grid pb-4">
            <t t-foreach="this.store.chartSuggestions" t-as="suggestion" t-key="suggestion_index">
              <ChartSuggestionPreview
                definition="suggestion.definition"
                description="suggestion.description"
                onPointerDown="(ev) => this.onStartChartSuggestionDrag(suggestion.definition, ev)"
              />
            </t>
          </div>
          <div t-else="" class="o-data-analysis-empty text-muted p-3">
            No chart suggestions available for the selected data. Note that the order of selected
            columns can impact chart suggestions.
          </div>
        </t>
      </SidePanelCollapsible>
      <SidePanelCollapsible
        t-if="this.store.generalStatItems.length > 0"
        title.translate="General statistics"
        isInitiallyCollapsed="false">
        <t t-set-slot="content">
          <Section class="'o-column-global-stats d-flex flex-column pt-0'">
            <GeneralStatsSection store="this.store"/>
          </Section>
        </t>
      </SidePanelCollapsible>
      <SidePanelCollapsible
        title="this.sectionTitle()"
        isInitiallyCollapsed="false"
        t-if="this.store.displayedAggregatedStatItems.length > 0 || this.store.displayedDateItems.length > 0">
        <t t-set-slot="content">
          <Section class="'o-column-global-stats d-flex flex-column pt-0'">
            <t t-if="this.store.displayedAggregatedStatItems.length > 0">
              <AggregatedStatistics store="this.store"/>
            </t>
            <t t-else="">
              <DateSection store="this.store"/>
            </t>
          </Section>
        </t>
      </SidePanelCollapsible>
      <div t-if="!this.store.hasStatistics" class="o-data-analysis-empty text-muted p-3">
        No general statistics available for the selected data. Note that selecting unique
        contiguous columns is required to display statistics.
      </div>
    </div>
    <div t-else="" class="o-data-analysis-empty text-muted p-3">
      Select cells containing data to see suggestions. Note that the order of selected
      columns can impact suggestions.
    </div>
  </div>
</templates>
