<templates>
  <t t-name="o-spreadsheet-BooleanSection">
    <div class="p-1 ">
      <t t-foreach="this.props.section.items" t-as="stat" t-key="stat_index">
        <StatisticItem
          stat="stat"
          onHover.bind="this.hoverStat"
          computePercentage.bind="this.computePercentage"
        />
      </t>
    </div>
  </t>
</templates>
