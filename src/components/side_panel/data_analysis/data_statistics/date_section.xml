<templates>
  <t t-name="o-spreadsheet-DateSection">
    <div class="mt-2 d-flex align-items-center gap-1 p-1 o-stat-sort-header">
      <t t-if="this.store.shape.length > 1">Sum by</t>
      <t t-else="">Occurrences by</t>
      <Select
        class="'w-auto py-0 px-1 o-stat-date-granularity border-0'"
        popoverClass="'w-auto'"
        values="this.granularityOptions"
        selectedValue="this.store.dateGranularity"
        onChange.bind="this.onGranularitySelected"
      />
      <div
        t-on-click="() => this.store.toggleDateSort()"
        class="o-button-icon ms-auto d-flex align-items-center small text-right">
        <t t-if="this.store.dateSortType === 'desc'" t-call="o-spreadsheet-Icon.CARET_DOWN"/>
        <t t-if="this.store.dateSortType === 'asc'" t-call="o-spreadsheet-Icon.CARET_UP"/>
        <span t-if="this.store.dateSortType === 'chrono'" class="o-caret-sort-icon">
          <t t-call="o-spreadsheet-Icon.CARET_UP_DOWN"/>
        </span>
      </div>
    </div>
    <t t-foreach="this.store.displayedDateItems" t-as="stat" t-key="stat_index">
      <t t-if="stat.value !== '0'">
        <StatisticItem stat="stat" onHover.bind="this.hoverStat"/>
      </t>
    </t>
  </t>
</templates>
