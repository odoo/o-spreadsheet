<templates>
  <t t-name="o-spreadsheet-DateSection">
    <div class="mt-2 d-flex align-items-center gap-1 p-1 o-stat-sort-header">
      Occurrences by
      <Select
        class="'w-auto py-0 px-1 o-stat-date-granularity border-0'"
        popoverClass="'w-auto'"
        values="this.granularityOptions"
        selectedValue="this.dataAnalysisPlugin.dateGranularity()"
        onChange.bind="this.onGranularitySelected"
      />
      <div
        t-on-click="() => this.dataAnalysisPlugin.toggleDateSort()"
        class="o-button-icon ms-auto d-flex align-items-center small text-right">
        <t
          t-if="this.dataAnalysisPlugin.dateOccurenceSortType() === 'desc'"
          t-call="o-spreadsheet-Icon.CARET_DOWN"
        />
        <t
          t-if="this.dataAnalysisPlugin.dateOccurenceSortType() === 'asc'"
          t-call="o-spreadsheet-Icon.CARET_UP"
        />
        <span
          t-if="this.dataAnalysisPlugin.dateOccurenceSortType() === 'chrono'"
          class="o-caret-sort-icon">
          <t t-call="o-spreadsheet-Icon.CARET_UP_DOWN"/>
        </span>
      </div>
    </div>
    <t t-foreach="this.dataAnalysisPlugin.displayedDateItems()" t-as="stat" t-key="stat_index">
      <t t-if="stat.value !== '0'">
        <StatisticItem stat="stat" onHover.bind="this.onStatHovered"/>
      </t>
    </t>
  </t>
</templates>
