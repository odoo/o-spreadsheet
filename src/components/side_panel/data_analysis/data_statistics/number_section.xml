<templates>
  <t t-name="o-spreadsheet-NumberSection">
    <div class="p-1 ">
      <div
        t-if="this.props.section.label"
        class="fw-bold text-muted mt-2 d-flex justify-content-between">
        <t t-out="this.props.section.label"/>
      </div>
      <t t-foreach="this.props.section.items" t-as="stat" t-key="stat_index">
        <StatisticItem stat="stat" onHover.bind="this.hoverStat"/>
      </t>
    </div>
  </t>
</templates>
