<templates>
  <t t-name="o-spreadsheet-FormulasPerformance">
    <t t-if="this.perfProfile">
      <Section>
        <div class="d-flex flex-column gap-1">
          <div class="d-flex justify-content-between">
            <span class="text-muted">Total time</span>
            <span class="fw-bold" t-out="this.formatTime(this.totalTime)"/>
          </div>
          <div class="d-flex justify-content-between">
            <span class="text-muted">Cells</span>
            <span
              t-out="this.humanize(this.perfProfile.totalCells)"
              t-att-title="this.perfProfile.totalCells"
            />
          </div>
          <div class="d-flex justify-content-between">
            <span class="text-muted">Function calls</span>
            <span
              t-out="this.humanize(this.perfProfile.totalFunctionCalls)"
              t-att-title="this.perfProfile.totalFunctionCalls"
            />
          </div>
        </div>
      </Section>
      <Section>
        <div class="d-flex flex-column gap-1">
          <t t-foreach="this.perfProfile.entries.slice(0, 500)" t-as="entry" t-key="entry_index">
            <PerfItem
              label="entry.functionName"
              subLabel="this.stringifyRange(entry)"
              time="entry.time"
              totalTime="this.totalTime"
              isSelected="this.isSelected(entry_index)"
              onClick="() => this.selectEntry(entry_index)"
            />
          </t>
        </div>
      </Section>
    </t>
  </t>
</templates>
