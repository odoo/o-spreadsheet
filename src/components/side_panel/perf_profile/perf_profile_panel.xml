<templates>
  <t t-name="o-spreadsheet-PerfProfilePanel">
    <div class="o-perf-profile-panel">
      <t t-if="this.state.lastProfiledTime === 0">
        <Section>
          <div class="d-flex justify-content-center mt-3">
            <button class="o-button primary" t-on-click="this.startProfiling">
              Analyze performance
            </button>
          </div>
          <small class="text-muted d-flex justify-content-center mt-2">
            This may take a while.
          </small>
        </Section>
      </t>
      <t t-else="">
        <Section>
          <div class="d-flex justify-content-center mb-3">
            <button class="o-button" t-on-click="this.startProfiling">
              <div class="d-flex justify-content-center align-content-center">
                <i class="oi me-1" data-icon="refresh"/>
                Re-analyze
              </div>
            </button>
          </div>
          <BadgeSelection
            choices="this.perfSections"
            onChange="(perfSection) => this.onPerfSectionChange(perfSection)"
            selectedValue="this.state.currentPerfSection"
          />
        </Section>
        <t t-component="this.perfSectionComponent"/>
      </t>
    </div>
  </t>
</templates>
