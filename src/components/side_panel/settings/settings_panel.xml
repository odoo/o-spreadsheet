<templates>
  <t t-name="o-spreadsheet-SettingsPanel">
    <div class="o-settings-panel">
      <Section title.translate="Locale">
        <Select
          selectedValue="this.currentLocale.code"
          values="this.selectOptions"
          onChange="(value) => this.onLocaleChange(value)"
        />
        <div class="o-locale-preview mt-4 p-3 rounded border">
          <div>
            <span class="o-fw-bold me-1">Number:</span>
            <span t-out="this.numberFormatPreview"/>
          </div>
          <div>
            <span class="o-fw-bold me-1">Date:</span>
            <span t-out="this.dateFormatPreview"/>
          </div>
          <div>
            <span class="o-fw-bold me-1">Date time:</span>
            <span t-out="this.dateTimeFormatPreview"/>
          </div>
          <div>
            <span class="o-fw-bold me-1">First day of week:</span>
            <span t-out="this.firstDayOfWeek"/>
          </div>
        </div>
      </Section>

      <Section title="'Selection animation (debug)'">
        <div class="mb-2">
          <label class="o-fw-bold me-2">Duration (ms)</label>
          <input
            type="number"
            min="0"
            step="10"
            class="o-input w-25"
            t-att-value="this.animationConfig.duration"
            t-on-change="this.onAnimationDurationChange"
          />
        </div>
        <t t-set="disableOnMouseMoveLabel">Disable animation while dragging on the grid</t>
        <Checkbox
          label="disableOnMouseMoveLabel"
          value="this.animationConfig.disableOnMouseMove"
          onChange.bind="this.setDisableOnMouseMove"
        />
        <t t-set="disableOnWholeColRowLabel">
          Disable animation when a whole row/column is selected
        </t>
        <Checkbox
          label="disableOnWholeColRowLabel"
          value="this.animationConfig.disableOnWholeColRow"
          onChange.bind="this.setDisableOnWholeColRow"
        />
        <t t-set="disableOnWholeSheetLabel">Disable animation when the whole sheet is selected</t>
        <Checkbox
          label="disableOnWholeSheetLabel"
          value="this.animationConfig.disableOnWholeSheet"
          onChange.bind="this.setDisableOnWholeSheet"
        />
      </Section>

      <Section class="'pt-0'">
        <t t-set="message">Those settings affect all users.</t>
        <ValidationMessages messages="[message]" msgType="'info'"/>
      </Section>
    </div>
  </t>
</templates>
